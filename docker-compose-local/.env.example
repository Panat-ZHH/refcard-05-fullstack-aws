# Lokale Entwicklungswerte - KEINE echten Zugangsdaten. Kopieren nach .env (wird nicht committet, start.sh macht das automatisch):
#   cp .env.example .env
DB_NAME=db_biztrips
DB_USER=biztrips
DB_PASSWORD=local-dev-only
DB_ROOT_PASSWORD=local-dev-root-only
# lokaler S3-Ersatz (S3Mock akzeptiert beliebige Zugangsdaten)
S3_BUCKET=biztrips-images-local
S3_ACCESS_KEY=local-dev
S3_SECRET_KEY=local-dev-only

# Optional: andere Pfade zu den Repos (Default: Nachbarordner ../../refcard-05-*)
# BACKEND_CONTEXT=/pfad/zu/refcard-05-be-springboot-businesstrips
# FRONTEND_CONTEXT=/pfad/zu/refcard-05-fe-react-vite
# FRONTEND_PORT=3000
