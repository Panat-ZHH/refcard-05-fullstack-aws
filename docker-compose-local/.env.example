# Lokale Entwicklungswerte - KEINE echten Zugangsdaten. Kopieren nach .env (wird nicht committet):
#   cp .env.example .env
DB_NAME=db_biztrips
DB_USER=biztrips
DB_PASSWORD=local-dev-only
DB_ROOT_PASSWORD=local-dev-root-only
# MinIO (lokaler S3-Ersatz)
S3_BUCKET=biztrips-images-local
S3_ACCESS_KEY=minio-local
S3_SECRET_KEY=minio-local-dev-only

# Optional: lokale Checkouts statt GitHub als Build-Kontext verwenden
# BACKEND_CONTEXT=../../refcard-05-be-springboot-businesstrips
# FRONTEND_CONTEXT=../../refcard-05-fe-react-vite
